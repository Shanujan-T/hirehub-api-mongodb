DB_USER=root
DB_PASSWORD=your_password
DB_HOST=127.0.0.1
DB_NAME=hirehub
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=1440
FLASK_DEBUG=0
LOCAL_UPLOADS_ENABLED=0
PORT=5000

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

OPENROUTER_API_KEY=your_openrouter_key

ENABLE_WEEKLY_DIGEST_SCHEDULER=false

APIFY_TOKEN=your_apify_token
APIFY_NUMBEO_ACTOR=automation-lab/numbeo-scraper
NUMBEO_MIN_CONTRIBUTORS=10
APIFY_CITY_BATCH_PAUSE_S=2
ENABLE_COL_INDEX_SCHEDULER=false

BREVO_API_KEY=your_brevo_api_key
BREVO_FROM_EMAIL=verified-sender@example.com
BREVO_FROM_NAME=HireHub
